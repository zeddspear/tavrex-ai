{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/capture_agent_exchange.py\"",
            "timeout": 10,
            "statusMessage": "Capturing prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/capture_agent_exchange.py\"",
            "timeout": 10,
            "statusMessage": "Capturing final response"
          }
        ]
      }
    ]
  }
}
